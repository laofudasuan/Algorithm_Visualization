{
  "title": "图可视化测试",
  "displayName": "图可视化测试",
  "description": "测试图可视化组件的各种功能，包括动态添加节点、边、修改样式和添加视觉指示器等。",
  "tags": ["功能测试", "动态更新", "交互演示"],
  "width": 1000,
  "height": 600,
  "canvasWidth": "1200px",
  "canvasHeight": "600px",
  "graphNames": ["ExampleGraph-500-300", "ExampleGraph-1000-600"],
  "initialGraph": {
    "nodes": [],
    "edges": []
  },
  "info": "本测试页面展示了图可视化组件的各种交互功能。您可以通过点击下方的动画按钮来测试不同的图操作，包括添加节点和边、修改样式、高亮元素等。",
  "animations": {
    "addNode": {
      "name": "添加节点",
      "description": "添加一个新节点到图中",
      "sequence": [
        {
          "type": "addNode",
          "data": [
            {
              "id": "test-node-1",
              "x": 300,
              "y": 200,
              "label": "New",
              "size": 25,
              "style": { "fill": "#ff5722" }
            }
          ]
        }
      ]
    },
    "addEdge": {
      "name": "添加边",
      "description": "添加一条连接两个节点的边",
      "sequence": [
        {
          "type": "addEdge",
          "data": [
            {
              "id": "test-edge-1",
              "source": "test-node-1",
              "target": "1",
              "label": "新边测试",
              "style": { "stroke": "#ff5722", "strokeWidth": 3 }
            }
          ]
        }
      ]
    },
    "highlightNode": {
      "name": "高亮节点",
      "description": "高亮显示指定节点",
      "sequence": [
        {
          "type": "addIndicator",
          "data": {
            "id": "highlight-1",
            "type": "highlight",
            "target": "1",
            "color": "#ff0000",
            "size": 40
          }
        },
        {
          "type": "addIndicator",
          "data": {
            "id": "highlight-2",
            "type": "highlight",
            "target": "2",
            "color": "#ff0000",
            "size": 40
          }
        },
        {
          "type": "addIndicator",
          "data": {
            "id": "pulse-3",
            "type": "pulse",
            "target": "3",
            "color": "#ff0000",
            "size": 40
          }
        }
      ]
    },
    "removeHighlight": {
      "name": "移除高亮",
      "description": "移除节点的高亮显示",
      "sequence": [
        {
          "type": "removeIndicator",
          "data": "highlight-1"
        },
        {
          "type": "removeIndicator",
          "data": "highlight-2"
        },
        {
          "type": "removeIndicator",
          "data": "highlight-3"
        }
      ]
    },
    "completeSequence": {
      "name": "完整演示",
      "description": "执行完整的动画序列演示",
      "sequence": [
        {
          "type": "addNode",
          "data": [
            {
              "id": "demo-node",
              "x": 400,
              "y": 300,
              "label": "演示",
              "size": 30,
              "style": { "fill": "#2196f3" }
            }
          ]
        },
        {
          "type": "addEdge",
          "data": [
            {
              "id": "demo-edge",
              "source": "demo-node",
              "target": "5",
              "label": "演示边",
              "style": { "stroke": "#2196f3", "strokeWidth": 2 }
            }
          ]
        },
        {
          "type": "addIndicator",
          "data": {
            "id": "highlight-demo-node",
            "type": "highlight",
            "target": "demo-node",
            "color": "#ff0000",
            "size": 40
          }
        },
        {
          "type": "addIndicator",
          "data": {
            "id": "highlight-5",
            "type": "highlight",
            "target": "5",
            "color": "#ff0000",
            "size": 40
          }
        },
        {
          "type": "updateNode",
          "data": [
            {
              "id": "demo-node",
              "style": { "fill": "#ff9800" }
            }
          ]
        },
        {
          "type": "removeIndicator",
          "data": "highlight-demo-node"
        },
        {
          "type": "removeIndicator",
          "data": "highlight-5"
        }
      ]
    }
  }
}