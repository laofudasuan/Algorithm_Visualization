{
  "title": "空图测试",
  "displayName": "空图测试",
  "description": "测试图可视化组件的各种功能，包括动态添加节点、边、修改样式和添加视觉指示器等。",
  "tags": ["功能测试", "动态更新", "交互演示"],
  "width": 1000,
  "height": 600,
  "canvasWidth": "1200px",
  "canvasHeight": "600px",
  "graphNames": ["EmptyGraph"],
  "initialGraph": {
    "nodes": [],
    "edges": []
  },
  "info": "测试空图的编辑",
  "animations": {
    "addNode": {
      "name": "添加节点",
      "description": "添加一个新节点到图中",
      "sequence": [
        {
          "type": "addNode",
          "data": {
            "id": "test-node-1",
            "x": 300,
            "y": 200,
            "label": "New",
            "size": 25,
            "style": { "fill": "#ff5722" }
          }
        },
        {
          "type": "addNode",
          "data": {
            "id": "test-node-2",
            "x": 600,
            "y": 400,
            "label": "New",
            "size": 25,
            "style": { "fill": "#ff5722" }
          }
        }
      ]
    },
    "addEdge": {
      "name": "添加边",
      "description": "添加一条连接两个节点的边",
      "sequence": [
        {
          "type": "addEdge",
          "data": {
            "id": "test-edge-1",
            "source": "test-node-1",
            "target": "test-node-2",
            "label": "新边测试",
            "style": { "stroke": "#ff5722", "strokeWidth": 3 }
          }
        }
      ]
    },
    "updateNodePosition": {
      "name": "修改点位置",
      "description": "更新指定节点的位置",
      "sequence": [
        {
          "type": "updateNode",
          "data": {
            "id": "test-node-1",
            "x": 100,
            "y": 200
          }
        }
      ]
    }
  }
}